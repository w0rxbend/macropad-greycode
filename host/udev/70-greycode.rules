# Lets the logged-in user open the greycode pad's raw HID interface (greyd and Vial need it).
#   sudo cp 70-greycode.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", TAG+="uaccess"
