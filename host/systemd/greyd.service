# User service: systemctl --user enable --now greyd   (see host/README.md)
[Unit]
Description=greycode macropad host bridge
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.cargo/bin/greyd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
